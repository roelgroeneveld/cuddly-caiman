---
layout: base.njk
title: Blog
---

<div class="blog-page">
  <header class="page-header">
    <h1>Blog</h1>
    <p>Thoughts, notes, and musings</p>
  </header>

  <div class="blog-list">
    {% for post in collections.allBlogPosts %}
    <article class="blog-item {% if not post.data.title %}micropost-item{% endif %}">
      <div class="blog-item-header">
        {% if post.data.title %}
        <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
        {% endif %}
        <time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>
        {% if post.data.tags %}
        <div class="tags">
          {% for tag in post.data.tags %}
            {% if tag != "posts" and tag != "microposts" %}
            <span class="tag">{{ tag }}</span>
            {% endif %}
          {% endfor %}
        </div>
        {% endif %}
      </div>
      <div class="blog-item-content">
        {% if post.data.title %}
        {{ post.templateContent | safe | truncate(300) }}
        <a href="{{ post.url }}" class="read-more">Read more →</a>
        {% else %}
        {{ post.templateContent | safe }}
        {% endif %}
      </div>
    </article>
    {% endfor %}
  </div>
</div>
